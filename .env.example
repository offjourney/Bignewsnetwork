# Copy this file to .env and fill in real values for your machine.
# .env is already gitignored (see .gitignore's `.env*` pattern) — never commit real credentials.

# PostgreSQL connection string used by Prisma (prisma/schema.prisma) and by
# prisma/seed.ts. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bignewsnetwork:dev_local_only_pw@localhost:5432/bignewsnetwork?schema=public"

# Never prefix database credentials with NEXT_PUBLIC_ — anything with that
# prefix is shipped to the browser.
